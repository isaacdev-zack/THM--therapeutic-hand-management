# Copy to .env.local (never commit .env.local)
# Production: set the same keys in Vercel.

# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Resend (verify thm.co.ke domain first)
RESEND_API_KEY=
RESEND_FROM=THM Admissions <admissions@thm.co.ke>

# Admin dashboard login
ADMIN_EMAIL=admin@thm.co.ke
ADMIN_PASSWORD=
JWT_SECRET=
